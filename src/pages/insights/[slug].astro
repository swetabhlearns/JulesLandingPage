---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteNav from "../../components/SiteNav.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import Icon from "../../components/Icon.astro";
import { articleSchema } from "../../lib/schema";
import { getPublishedBlogPosts } from "../../lib/blog";

export async function getStaticPaths() {
  const posts = await getPublishedBlogPosts();
  return posts.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props;
const dateFormatter = new Intl.DateTimeFormat("en-IN", {
  day: "numeric",
  month: "short",
  year: "numeric",
});
const formatDate = (value: string | undefined) => {
  if (!value) return null;
  const date = new Date(value);
  return Number.isNaN(date.getTime()) ? null : dateFormatter.format(date);
};
const publishedDate = formatDate(article.publishedAt);
const modifiedDate = formatDate(article.updatedAt);
const showModifiedDate = modifiedDate && modifiedDate !== publishedDate;
---

<BaseLayout
  title={`${article.title} | BKT Tactical`}
  description={article.description}
  canonical={`https://bkttactical.com${article.path}`}
  ogType="article"
  publishedTime={article.publishedAt}
  modifiedTime={article.updatedAt}
  schema={articleSchema(article)}
  bodyClass="bg-surface text-on-surface antialiased"
>
  <SiteNav />

  <main>
    <article>
      <section class="relative overflow-hidden min-h-[64svh] flex items-center bg-primary text-white py-28 md:py-36 reveal" style="background-color: #1A36B0;">
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_78%_18%,rgba(186,195,255,0.28),transparent_32%),linear-gradient(135deg,rgba(0,17,90,0.38),rgba(26,54,176,0)_55%)]"></div>
        <div class="relative px-4 sm:px-6 md:px-12 max-w-6xl mx-auto w-full">
          <div class="text-xs uppercase tracking-[0.35em] text-white/65 mb-6">{article.category}</div>
          <h1 class="text-4xl sm:text-5xl md:text-6xl font-medium tracking-tight leading-[1.08] mb-7 max-w-5xl">{article.title}</h1>
          {publishedDate ? (
            <div class="mb-7 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-white/70">
              <span>Published {publishedDate}</span>
              {showModifiedDate ? <span>Updated {modifiedDate}</span> : null}
            </div>
          ) : null}
          <div class="article-prose article-prose-invert max-w-3xl" set:html={article.intro} />
        </div>
      </section>

      <section class="py-20 md:py-28 bg-white reveal">
        <div class="px-4 sm:px-6 md:px-12 max-w-6xl mx-auto">
          <div class="grid gap-12 lg:grid-cols-[220px_minmax(0,1fr)] lg:gap-16">
            <aside class="hidden lg:block">
              <div class="sticky top-28 border-l-2 border-primary/20 pl-6">
                <div class="text-xs uppercase tracking-[0.28em] text-primary mb-4">Article Guide</div>
                <dl class="space-y-5 text-sm text-on-surface-variant">
                  <div>
                    <dt class="text-xs uppercase tracking-[0.22em] text-slate-400 mb-1">Category</dt>
                    <dd class="text-on-surface">{article.category}</dd>
                  </div>
                  {publishedDate ? (
                    <div>
                      <dt class="text-xs uppercase tracking-[0.22em] text-slate-400 mb-1">Published</dt>
                      <dd class="text-on-surface">{publishedDate}</dd>
                    </div>
                  ) : null}
                  {showModifiedDate ? (
                    <div>
                      <dt class="text-xs uppercase tracking-[0.22em] text-slate-400 mb-1">Updated</dt>
                      <dd class="text-on-surface">{modifiedDate}</dd>
                    </div>
                  ) : null}
                  <div>
                    <dt class="text-xs uppercase tracking-[0.22em] text-slate-400 mb-1">Sections</dt>
                    <dd class="text-on-surface">{article.sections.length} key points</dd>
                  </div>
                  {article.faq?.length ? (
                    <div>
                      <dt class="text-xs uppercase tracking-[0.22em] text-slate-400 mb-1">FAQ</dt>
                      <dd class="text-on-surface">{article.faq.length} answers</dd>
                    </div>
                  ) : null}
                </dl>
              </div>
            </aside>

            <div class="max-w-[72ch]">
              <div class="space-y-14 md:space-y-16">
                {article.sections.map((section, index) => (
                  <section class="border-t border-slate-100 pt-8 first:border-t-0 first:pt-0">
                    <div class="text-xs uppercase tracking-[0.28em] text-primary mb-4">Section {String(index + 1).padStart(2, "0")}</div>
                    <h2 class="text-3xl md:text-4xl font-medium tracking-tight leading-tight mb-5">{section.heading}</h2>
                    <div class="article-prose" set:html={section.body} />
                  </section>
                ))}
              </div>

              {article.faq?.length ? (
                <div class="mt-20 border-t border-slate-200 pt-12">
                  <div class="text-xs uppercase tracking-[0.28em] text-primary mb-4">Common Questions</div>
                  <h2 class="text-3xl md:text-4xl font-medium tracking-tight mb-8">FAQ</h2>
                  <div class="space-y-5">
                    {article.faq.map((item) => (
                      <section class="border border-slate-100 bg-slate-50 p-6 md:p-7 rounded-sm">
                        <h3 class="text-xl md:text-2xl font-medium tracking-tight leading-snug mb-3">{item.question}</h3>
                        <div class="article-prose" set:html={item.answer} />
                      </section>
                    ))}
                  </div>
                </div>
              ) : null}

              <div class="mt-20 border-t border-slate-200 pt-10">
                <div class="bg-primary text-white p-6 md:p-8 rounded-sm flex flex-col sm:flex-row gap-5 sm:items-center sm:justify-between" style="background-color: #1A36B0;">
                  <a class="inline-flex items-center gap-3 text-white/85 hover:text-white font-medium" href="/insights/">
                    <Icon name="arrow_back" size={18} />
                    Back to blogs
                  </a>
                  <a class="inline-flex items-center justify-center gap-3 bg-white text-primary px-7 py-4 rounded-sm font-medium" href="/contact/">
                    Discuss UAV requirements
                    <Icon name="arrow_forward" size={18} />
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
    </article>
  </main>

  <SiteFooter />
</BaseLayout>
