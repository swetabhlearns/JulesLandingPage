---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteNav from "../components/SiteNav.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Icon from "../components/Icon.astro";
import { products, solutions } from "../lib/seo-data";
import { solutionsSchema } from "../lib/schema";
---

<BaseLayout
  title="Drone, Tactical, Training & Field Solutions India | BKT Tactical"
  description="Explore UAV solutions for drone logistics, tactical FPV support, Speaker Drone communication, agriculture, mining, training, and field deployment in India."
  schema={solutionsSchema()}
  bodyClass="bg-surface text-on-surface antialiased"
>
  <SiteNav />

  <main>
    <section class="min-h-[78svh] flex items-center bg-primary text-white py-28 md:py-40 reveal" style="background-color: #1A36B0;">
      <div class="px-4 sm:px-6 md:px-12 max-w-7xl mx-auto w-full">
        <div class="max-w-4xl">
          <div class="w-12 h-1 bg-white mb-8"></div>
          <h1 class="text-4xl sm:text-5xl md:text-7xl font-medium tracking-tight leading-[1.08] mb-8">Drone, tactical, training, and field deployment solutions for India.</h1>
          <p class="text-lg md:text-2xl text-white/78 leading-relaxed max-w-3xl">
            BKT Tactical supports UAV missions across logistics, tactical FPV support, Speaker Drone communication, emergency response, agriculture, mining, training, and deployment workflows.
          </p>
        </div>
      </div>
    </section>

    <section class="py-20 md:py-32 bg-white reveal">
      <div class="px-4 sm:px-6 md:px-12 max-w-7xl mx-auto">
        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-8">
          {solutions.map((solution, index) => (
            <article class="border border-slate-100 bg-slate-50 rounded-sm p-8 md:p-10 hover-card-blue group transition-all duration-300">
              <div class="text-xs uppercase tracking-[0.28em] text-primary mb-6 group-hover:text-white/70">{String(index + 1).padStart(2, "0")}</div>
              <h2 class="text-3xl font-medium mb-5 group-hover:text-white">{solution.name}</h2>
              <p class="text-on-surface-variant leading-relaxed group-hover:text-white/82">{solution.description}</p>
            </article>
          ))}
        </div>

        <div class="mt-20 border-t border-slate-100 pt-16">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-start mb-20">
            <div class="lg:col-span-5">
              <span class="text-primary font-medium text-xs uppercase tracking-widest block mb-4">Capability Groups</span>
              <h2 class="text-4xl md:text-5xl font-medium tracking-tight">From platforms to training and field execution.</h2>
            </div>
            <div class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-2 gap-px bg-slate-100 border border-slate-100">
              {[
                ["Platforms", "Trishul 10kg, 16kg, and 30kg UAV configurations for payload-led logistics and field missions."],
                ["Field Solutions", "Tactical observation support, Speaker Drone communication, emergency response, and deployment planning."],
                ["Sector Applications", "Agriculture monitoring, mining survey support, mapping, and repeatable data collection workflows."],
                ["Training & Integration", "FPV assembly, heavy payload drone integration, flight training, troubleshooting, and maintenance readiness."],
              ].map(([title, body]) => (
                <div class="bg-white p-6 md:p-8">
                  <h3 class="text-2xl font-medium mb-4">{title}</h3>
                  <p class="text-on-surface-variant leading-relaxed text-sm">{body}</p>
                </div>
              ))}
            </div>
          </div>

          <h2 class="text-4xl md:text-5xl font-medium tracking-tight mb-10">Match the UAV to the operating requirement.</h2>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            {products.map((product) => (
              <a class="block border border-slate-100 bg-white p-7 rounded-sm hover:bg-primary hover:text-white transition-colors group" href={product.path}>
                <div class="flex items-center justify-between gap-4 mb-4">
                  <h3 class="text-2xl font-medium">{product.shortName}</h3>
                  <Icon class="text-primary group-hover:text-white transition-colors" name="arrow_forward" />
                </div>
                <p class="text-sm text-on-surface-variant group-hover:text-white/75">{product.payload} payload, {product.endurance} endurance.</p>
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>
